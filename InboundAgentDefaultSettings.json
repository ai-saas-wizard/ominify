{
  "name": "{{AGENT_NAME}} (Inbound Agent)",
  "voice": {
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "style": 0.2,
    "voiceId": "{{ELEVENLABS_VOICE_ID}}",
    "provider": "11labs",
    "stability": 0.4,
    "similarityBoost": 0.6,
    "useSpeakerBoost": false
  },
  "model": {
    "model": "gpt-4o-mini",
    "toolIds": "{{TOOL_IDS}}",
    "messages": [
      {
        "role": "system",
        "content": "{{SYSTEM_PROMPT}}"
      }
    ],
    "provider": "openai",
    "maxTokens": 250,
    "temperature": 0.65
  },
  "recordingEnabled": true,
  "firstMessage": "",
  "voicemailMessage": "",
  "endCallFunctionEnabled": true,
  "endCallMessage": "",
  "transcriber": {
    "model": "nova-3",
    "language": "en",
    "numerals": true,
    "provider": "deepgram"
  },
  "clientMessages": [
    "transcript",
    "hang",
    "function-call",
    "speech-update",
    "metadata",
    "conversation-update",
    "status-update",
    "assistant.started"
  ],
  "serverMessages": [
    "end-of-call-report",
    "status-update",
    "hang",
    "function-call",
    "conversation-update",
    "assistant.started",
    "transfer-update",
    "speech-update"
  ],
  "dialKeypadFunctionEnabled": true,
  "endCallPhrases": [
    "goodbye",
    "talk to you soon"
  ],
  "maxDurationSeconds": 3083,
  "firstMessageMode": "assistant-speaks-first-with-model-generated-message",
  "voicemailDetection": {
    "provider": "vapi",
    "backoffPlan": {
      "maxRetries": 6,
      "startAtSeconds": 5,
      "frequencySeconds": 5
    },
    "beepMaxAwaitSeconds": 0
  },
  "messagePlan": {
    "idleMessages": [
      "Are you still there?"
    ]
  },
  "stopSpeakingPlan": {
    "numWords": 3
  },
  "server": {
    "url": "{{SERVER_WEBHOOK_URL}}",
    "timeoutSeconds": 20
  },
  "compliancePlan": {
    "hipaaEnabled": false,
    "pciEnabled": false
  }
}