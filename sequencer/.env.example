# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Redis
REDIS_URL=redis://localhost:6379

# Twilio (main account for subaccounts)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...

# OpenAI (for AI sequence generation)
OPENAI_API_KEY=sk-...

# Encryption key for API keys (32-byte hex string)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Webhook Base URL (your domain where webhooks are received)
WEBHOOK_BASE_URL=https://your-domain.com

# Base URL embedded in email tracking pixels / click links / unsubscribe links
TRACKING_BASE_URL=https://your-domain.com

# Webhook & admin auth (REQUIRED in production — middleware fails closed
# with 503 when unset)
VAPI_WEBHOOK_SECRET=...
ADMIN_API_TOKEN=...
LEAD_INGESTION_API_TOKEN=...
EMAIL_INBOUND_API_TOKEN=...

# Optional: HMAC secret for signed click-tracking URLs (falls back to ENCRYPTION_KEY)
TRACKING_SIGNING_SECRET=...

# Optional: comma-separated CORS allowlist for the webhook server
CORS_ALLOWED_ORIGINS=https://app.your-domain.com

# Server ports
WEBHOOK_PORT=3000
ADMIN_PORT=3001

# Environment
NODE_ENV=development
